[user]
	name = Rob Peters
	email = rjpcal@gmail.com
[push]
	default = current
	autoSetupRemote = true
[color]
	diff = auto
	status = auto
	branch = auto
	ui = auto
[credential]
	helper = cache --timeout=1200
	helper = /usr/local/share/gcm-core/git-credential-manager
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff]
	algorithm = minimal
[credential "https://dev.azure.com"]
	useHttpPath = true
[rebase]
	updateRefs = true
